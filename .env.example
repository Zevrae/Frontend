VITE_API_URL = 'http://localhost:5000/api/'

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0
# Client ID (Web application). Must match the backend's GOOGLE_CLIENT_ID —
# add this app's exact origin(s) to "Authorized JavaScript origins" in that

# Backend API Base URL
# Use '/api' to leverage Next.js rewrite proxy (proxies to https://api.zevrae.com with no CORS issues)
# Or set 'http://localhost:5000/api' if you are running a local backend server on port 5000
NEXT_PUBLIC_API_URL=/api

# Optional: destination backend for Next.js rewrite proxy (defaults to https://api.zevrae.com)
# BACKEND_URL=https://api.zevrae.com

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0
# Client ID (Web application). Must match the backend's GOOGLE_CLIENT_ID —
# add this app's exact origin(s) to "Authorized JavaScript origins" in that
# credential's settings, or Google will reject the sign-in popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=